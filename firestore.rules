rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validDeck() {
      return request.resource.data.keys().hasOnly(['content','revision','lastVersionId','updatedAt','updatedBy'])
        && request.resource.data.content is list
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 35
        && request.resource.data.revision is int
        && request.resource.data.lastVersionId is string
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy.size() <= 40
        && request.resource.data.updatedAt == request.time;
    }
    function linkedHistory() {
      return existsAfter(/databases/$(database)/documents/versions/$(request.resource.data.lastVersionId))
        && getAfter(/databases/$(database)/documents/versions/$(request.resource.data.lastVersionId)).data.revision == request.resource.data.revision
        && getAfter(/databases/$(database)/documents/versions/$(request.resource.data.lastVersionId)).data.snapshot == request.resource.data.content;
    }
    match /decks/main {
      allow read: if true;
      allow create: if signedIn() && validDeck() && request.resource.data.revision == 1 && linkedHistory();
      allow update: if signedIn() && validDeck()
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.lastVersionId != resource.data.lastVersionId
        && linkedHistory();
      allow delete: if false;
    }
    match /versions/{versionId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['snapshot','revision','author','message','createdAt'])
        && request.resource.data.revision is int
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 120
        && request.resource.data.snapshot is list
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/decks/main).data.lastVersionId == versionId
        && getAfter(/databases/$(database)/documents/decks/main).data.revision == request.resource.data.revision
        && getAfter(/databases/$(database)/documents/decks/main).data.content == request.resource.data.snapshot;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}